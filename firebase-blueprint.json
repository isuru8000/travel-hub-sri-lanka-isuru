{
  "entities": {
    "Destination": {
      "title": "Destination",
      "description": "A travel destination.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "description", "location", "imageUrl"]
    },
    "Review": {
      "title": "Review",
      "description": "A user review for a destination.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "destinationId": { "type": "string" },
        "userId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["destinationId", "userId", "rating", "comment", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "photo": { "type": "string" },
        "role": { "type": "string" },
        "explorerProfileId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "createdAt"]
    },
    "Memory": {
      "title": "Memory",
      "description": "A travel memory shared by a user.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "location": { "type": "object" },
        "title": { "type": "object" },
        "story": { "type": "object" },
        "image": { "type": "string" },
        "likes": { "type": "number" },
        "rating": { "type": "number" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "userName", "title", "story", "image", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a memory.",
      "type": "object",
      "properties": {
        "authorUid": { "type": "string" },
        "userName": { "type": "string" },
        "userPhoto": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorUid", "userName", "text", "createdAt"]
    }
  },
  "firestore": {
    "destinations/{destinationId}": {
      "schema": { "$ref": "Destination" },
      "description": "Collection of travel destinations."
    },
    "reviews/{reviewId}": {
      "schema": { "$ref": "Review" },
      "description": "Collection of user reviews."
    },
    "users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Collection of user profiles."
    },
    "memories/{memoryId}": {
      "schema": { "$ref": "Memory" },
      "description": "Collection of travel memories."
    },
    "memories/{memoryId}/comments/{commentId}": {
      "schema": { "$ref": "Comment" },
      "description": "Subcollection of comments on a memory."
    }
  }
}
