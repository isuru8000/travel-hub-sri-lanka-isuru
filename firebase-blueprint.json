{
  "entities": {
    "Destination": {
      "title": "Destination",
      "description": "A travel destination.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "location": { "type": "string" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name", "description", "location", "imageUrl"]
    },
    "Review": {
      "title": "Review",
      "description": "A user review for a destination.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "destinationId": { "type": "string" },
        "userId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["destinationId", "userId", "rating", "comment", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "photo": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "name", "role", "createdAt"]
    }
  },
  "firestore": {
    "destinations/{destinationId}": {
      "schema": { "$ref": "Destination" },
      "description": "Collection of travel destinations."
    },
    "reviews/{reviewId}": {
      "schema": { "$ref": "Review" },
      "description": "Collection of user reviews."
    },
    "users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "Collection of user profiles."
    }
  }
}
